language core;

fn make_list(n : Nat) -> List[Nat] {
  return Nat::rec(n, List::nil as List[Nat], |i, rest| List::cons(i, rest))
}

fn length(xs : List[Nat]) -> Nat {
  return match xs {
    List::nil => Nat::zero
  | List::cons(head, tail) => Nat::succ(length(tail))
  }
}

fn main(n : Nat) -> Nat {
  return let first = make_list(n) in
    let second = make_list(Nat::succ(n)) in
      Nat::rec(length(first), length(second), |i, total| Nat::succ(total))
}